[Unit]
Description=Prostudio v1 - FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/prostudio-v1/backend
ExecStart=/opt/prostudio-v1/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Optional: put server-side keys in /opt/prostudio-v1/backend/.env
EnvironmentFile=-/opt/prostudio-v1/backend/.env

[Install]
WantedBy=multi-user.target
